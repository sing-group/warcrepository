APP_NAME=WARC-Repository
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Mismo coste que los hashes de contraseña ya guardados (Laravel 5.3).
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=infowarcrepository@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Tokens JWT de la API. Si no se define, se usa el mismo secreto por defecto
# que tenía la app con Laravel 5.3 (así los clientes no notan el cambio).
# JWT_SECRET=

# true añade "debug" (traza) a los errores JSON de la API, como API_DEBUG de Dingo.
API_DEBUG=false

VITE_APP_NAME="${APP_NAME}"
